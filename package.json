{
  "name": "m3-expressive-web",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental Material 3 Expressive component library for React and the web.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation/index.d.ts",
      "import": "./dist/foundation/index.js"
    },
    "./foundation/adaptive-layout": {
      "types": "./dist/foundation/adaptive-layout/index.d.ts",
      "import": "./dist/foundation/adaptive-layout/index.js"
    },
    "./foundation/color": {
      "types": "./dist/foundation/color/index.d.ts",
      "import": "./dist/foundation/color/index.js"
    },
    "./foundation/color/generator": {
      "types": "./dist/foundation/color/generator.d.ts",
      "import": "./dist/foundation/color/generator.js"
    },
    "./foundation/elevation": {
      "types": "./dist/foundation/elevation/index.d.ts",
      "import": "./dist/foundation/elevation/index.js"
    },
    "./foundation/motion": {
      "types": "./dist/foundation/motion/index.d.ts",
      "import": "./dist/foundation/motion/index.js"
    },
    "./foundation/shape": {
      "types": "./dist/foundation/shape/index.d.ts",
      "import": "./dist/foundation/shape/index.js"
    },
    "./foundation/state": {
      "types": "./dist/foundation/state/index.d.ts",
      "import": "./dist/foundation/state/index.js"
    },
    "./foundation/typography": {
      "types": "./dist/foundation/typography/index.d.ts",
      "import": "./dist/foundation/typography/index.js"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:stories": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.4.0"
  }
}
